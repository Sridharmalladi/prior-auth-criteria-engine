# Copy this file to .env and fill in your key. .env is gitignored and is never
# shipped to docs/ or read by anything in docs/js/ — it is used only by the
# offline pipeline scripts run from a developer machine.

OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides. Defaults are set in the scripts themselves.
# OPENROUTER_PARSE_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_EXTRACT_MODEL=anthropic/claude-haiku-4.5
